# Cache rules (Netlify / Cloudflare Pages format; other hosts ignore this file).
# Vite's build files carry a content hash in their names, so they can be cached forever.
/assets/*.js
  Cache-Control: public, max-age=31536000, immutable
/assets/*.css
  Cache-Control: public, max-age=31536000, immutable
# Hero media and site photos: not hashed, so a week, revalidated after.
/plates/*
  Cache-Control: public, max-age=604800
/models/*
  Cache-Control: public, max-age=604800
/intro-*
  Cache-Control: public, max-age=604800
/assets/uploads/*
  Cache-Control: public, max-age=604800
