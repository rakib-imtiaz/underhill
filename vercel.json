{
  "headers": [
    { "source": "/assets/(.*)\.(js|css)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] },
    { "source": "/plates/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800" }] },
    { "source": "/models/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800" }] },
    { "source": "/intro-(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800" }] },
    { "source": "/assets/uploads/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800" }] }
  ],
  "rewrites": [{ "source": "/((?!assets/|plates/|models/|intro-|.*\.).*)", "destination": "/index.html" }]
}
